# Bot token for the THROWAWAY dev application. Never the production token.
DISCORD_TOKEN=your_dev_bot_token_here

# Application (client) ID from the Developer Portal, OAuth2 page.
CLIENT_ID=your_dev_application_id_here

# The server the /pose command is registered to. Your private test server here.
GUILD_ID=your_test_server_id_here

# Optional. The Admin role mentioned (without a ping) in the pose and expiry
# messages. Leave blank to say "an admin" in plain text.
ADMIN_ROLE_ID=

# Optional. Minutes before a pose expires. Whole number from 1 to 60. Default 5.
POSE_TIMEOUT_MINUTES=5
